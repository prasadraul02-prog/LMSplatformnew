generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



// Enums converted to String for SQLite compatibility
// Role: ADMIN, TRAINER, EMPLOYEE
// Level: BASIC, INTERMEDIATE, ADVANCED, EXPERT
// ModuleType: VIDEO, PDF, PPT, QUIZ, ASSIGNMENT
// EnrollmentStatus: PENDING, ACTIVE, COMPLETED, REJECTED

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          String    @default("EMPLOYEE")
  avatar        String?   // Selected avatar style (e.g., "bottts", "avataaars", etc.)
  departmentId  String?
  designationId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  department    Department? @relation(fields: [departmentId], references: [id])
  designation   Designation? @relation(fields: [designationId], references: [id])
  
  enrollments   Enrollment[]
  certificates  Certificate[]
  notifications Notification[]
  createdCourses Course[] @relation("CreatedCourses")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  trainingRules TrainingRule[]
}

model Designation {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  trainingRules TrainingRule[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  level       String   @default("BASIC")
  thumbnail   String?
  published   Boolean  @default(false)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation("CreatedCourses", fields: [authorId], references: [id])
  modules     Module[]
  enrollments Enrollment[]
  certificates Certificate[]
  trainingRules TrainingRule[]
}

model Module {
  id          String     @id @default(cuid())
  title       String
  type        String
  contentUrl  String?    // For Video, PDF, PPT
  description String?
  order       Int
  courseId    String
  
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz        Quiz?
  progress    ModuleProgress[]
}

model Quiz {
  id          String   @id @default(cuid())
  moduleId    String   @unique
  timeLimit   Int?     // In minutes
  passScore   Int      @default(70) // Percentage
  
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions   Question[]
  results     QuizResult[]
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  text        String
  type        String
  options     String
  explanation String?
  
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      String           @default("PENDING")
  progress    Int              @default(0) // Percentage
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  user        User             @relation(fields: [userId], references: [id])
  course      Course           @relation(fields: [courseId], references: [id])
  moduleProgress ModuleProgress[]

  @@unique([userId, courseId])
}

model ModuleProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  moduleId     String
  completed    Boolean  @default(false)
  
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  module       Module     @relation(fields: [moduleId], references: [id])

  @@unique([enrollmentId, moduleId])
}

model QuizResult {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  score       Int
  passed      Boolean
  attemptedAt DateTime @default(now())

  quiz        Quiz     @relation(fields: [quizId], references: [id])
}

model Certificate {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  issueDate DateTime @default(now())
  pdfUrl    String?

  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model TrainingRule {
  id            String       @id @default(cuid())
  name          String
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id])
  createdAt     DateTime     @default(now())
}

// ===== Training Management System Models =====

model Employee {
  id              String            @id @default(cuid())
  employeeId      String            @unique
  name            String
  location        String
  trainingLevel   String            @default("UNTRAINED") // UNTRAINED, BASIC, ADVANCE, EXPERT
  department      String?
  designation     String?
  email           String?
  phone           String?
  region          String?
  // Excel columns 1-8 (flexible JSON field for additional data)
  additionalData  String?           // JSON string for extra columns
  uploadBatchId   String?
  uploadedAt      DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  trainingRequests TrainingRequest[]
  
  @@index([location])
  @@index([trainingLevel])
}

model WorkshopManager {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  location        String
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  trainingRequests TrainingRequest[]
  
  @@index([location])
  @@index([email])
}

model TrainingRequest {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  originalLocation  String
  trainingLocation  String
  wmId              String?
  workshopManager   WorkshopManager? @relation(fields: [wmId], references: [id])
  status            String           @default("PENDING") // PENDING, SENT, APPROVED, REJECTED
  approveToken      String?          @unique
  rejectToken       String?          @unique
  requestSentAt     DateTime?
  respondedAt       DateTime?
  batchId           String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  @@index([status])
  @@index([batchId])
  @@index([wmId])
}

// ===== Standalone Quiz System Models =====

model StandaloneQuiz {
  id                String         @id @default(cuid())
  title             String
  description       String?
  instructions      String?
  timeLimit         Int?           // In minutes
  passScore         Int            @default(70) // Percentage
  shuffleQuestions  Boolean        @default(false)
  shuffleOptions    Boolean        @default(false)
  showResults       Boolean        @default(true)
  showAnswers       Boolean        @default(true)
  allowReview       Boolean        @default(true)
  maxAttempts       Int?           // null = unlimited
  isActive          Boolean        @default(true)
  createdBy         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  questions         QuizQuestion[]
  links             QuizLink[]
  attempts          QuizAttempt[]
  
  @@index([createdBy])
  @@index([isActive])
}

model QuizQuestion {
  id            String         @id @default(cuid())
  quizId        String
  text          String         @db.Text
  imageUrl      String?
  explanation   String?        @db.Text
  points        Int            @default(1)
  order         Int
  questionType  String         @default("SINGLE") // SINGLE, MULTIPLE
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  quiz          StandaloneQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options       QuizOption[]
  answers       QuizAnswer[]
  
  @@index([quizId])
  @@index([order])
}

model QuizOption {
  id          String       @id @default(cuid())
  questionId  String
  text        String       @db.Text
  imageUrl    String?
  isCorrect   Boolean      @default(false)
  order       Int
  
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]
  
  @@index([questionId])
}

model QuizLink {
  id              String         @id @default(cuid())
  quizId          String
  linkCode        String         @unique // Unique shareable code
  name            String?        // Optional name for the link
  isEnabled       Boolean        @default(true)
  maxUses         Int?           // null = unlimited
  currentUses     Int            @default(0)
  expiresAt       DateTime?
  autoDisable     Boolean        @default(false) // Auto-disable after time limit
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  quiz            StandaloneQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attempts        QuizAttempt[]
  
  @@index([quizId])
  @@index([linkCode])
  @@index([isEnabled])
}

model QuizAttempt {
  id              String         @id @default(cuid())
  quizId          String
  linkId          String?
  employeeName    String
  employeeEmail   String
  employeeId      String?        // Optional employee ID
  score           Int
  totalPoints     Int
  percentage      Float
  passed          Boolean
  timeSpent       Int?           // In seconds
  startedAt       DateTime
  submittedAt     DateTime       @default(now())
  ipAddress       String?
  userAgent       String?
  
  quiz            StandaloneQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  link            QuizLink?      @relation(fields: [linkId], references: [id])
  answers         QuizAnswer[]
  
  @@index([quizId])
  @@index([linkId])
  @@index([employeeEmail])
  @@index([submittedAt])
}

model QuizAnswer {
  id          String       @id @default(cuid())
  attemptId   String
  questionId  String
  optionId    String?      // null if question was skipped
  isCorrect   Boolean      @default(false)
  timeSpent   Int?         // In seconds
  createdAt   DateTime     @default(now())
  
  attempt     QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    QuizQuestion @relation(fields: [questionId], references: [id])
  option      QuizOption?  @relation(fields: [optionId], references: [id])
  
  @@index([attemptId])
  @@index([questionId])
}

model Location {
  id          String   @id @default(cuid())
  name        String   @unique
  region      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  @@index([name])
}

model MasterEmployee {
  id                String    @id @default(cuid())
  uniqueId          String    @unique // Aadhar or equivalent
  organizationName  String
  employmentStatus  String    // Permanent / On Trial / Contract
  employeeId        String?   // Regular Employee ID
  name              String
  branch            String
  designation       String
  dateOfJoining     DateTime?
  
  // Dynamic columns stored as JSON string
  // This satisfies the "No Fixed Columns" requirement by allowing any extra data
  additionalData    String?   @db.Text
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([uniqueId])
  @@index([organizationName])
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}
